# ===========================================
# TUP-Manila USMS Environment Variables
# ===========================================
# Copy this file to .env.local and fill in your actual values.
# .env.local is gitignored — never commit real keys.

# Supabase - Get these from: Project Settings -> API Keys
# (Use the new sb_publishable_... and sb_secret_... format if available)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key

# SERVER ONLY - bypasses RLS, never expose to client
SUPABASE_SERVICE_ROLE_KEY=your-service-role-or-secret-key

# Anthropic API Key - For AI concern summarization
# Get from: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=your-anthropic-api-key

# App URL - http://localhost:3000 for dev, your Vercel URL in production
# Also used to build the links inside notification emails, so it must be the
# real origin in production or every button in every email points at localhost.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ===========================================
# EMAIL NOTIFICATIONS
# ===========================================
# Which adapter carries the mail. Leave unset (or "console") and nothing is
# actually sent - the message is written to the server log instead. That is
# the intended default for development: nothing can reach a real student
# unless someone deliberately configures a provider.
#   console | gmail | resend
EMAIL_PROVIDER=console

# Display name and address on the message. Gmail rewrites the address part to
# the authenticated account, so with EMAIL_PROVIDER=gmail only the name shows.
EMAIL_FROM=TUP-Manila USMS <your.account@gmail.com>

# --- Gmail SMTP (no domain required, ~500 messages/day) ---
# Needs 2-Step Verification on the account, then an App Password from
# https://myaccount.google.com/apppasswords - NOT the account password.
GMAIL_USER=your.account@gmail.com
GMAIL_APP_PASSWORD=your-16-character-app-password

# --- Resend (needs a domain you control; the upgrade path) ---
# Register a domain, add the DNS records Resend gives you, then set
# EMAIL_PROVIDER=resend and EMAIL_FROM to an address on that domain.
# RESEND_API_KEY=re_your_api_key

# Safety net outside production: a comma-separated list of the ONLY addresses
# that may be mailed. Everything else is recorded as skipped. This exists so a
# seeded or restored database cannot mail real students about cases that were
# never filed. Ignored when VERCEL_ENV or NODE_ENV is "production".
# An empty value blocks everything, which is the safe reading.
EMAIL_ALLOWLIST=your.own.address@gmail.com

# Account invitations (the one-time sign-in links sent by an enrollment
# import) share the mail account's daily limit with disciplinary notices.
# This caps invitations per 24 hours so a large import can never use up the
# quota a summons needs. Gmail allows ~500/day: keep this well under it.
# On Resend's free tier (100/day), lower it to about 50.
INVITATIONS_PER_DAY=300

# Shared secret between pg_cron and /api/notifications/dispatch. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# The same value goes into Supabase Vault as 'usms_cron_secret'
# (see migration 00019, section 6). Without it the endpoint refuses every call.
CRON_SECRET=generate-a-long-random-string
